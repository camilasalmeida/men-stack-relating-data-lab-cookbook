<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Pantry</title>
  </head>


  <body>
    <%- include('./partials/_navbar.ejs') %>
    <h1>Welcome to my Pantry</h1>
        <ul>
            <% if (pantryItems && pantryItems.length > 0 ) { %>
                <% pantryItems.forEach((food) => { %>
        <li>
            <a href="/users/<%= user._id %>/foods/<%= food._id %>">
                Food: <%= food.name %>, Expiration Date: <%= new Date(food.expirationDate).toLocaleDateString() %>
            </a>
        </li>
    <% }) %>
    <% } else { %>
        <li>There are no items in this pantry.</li>
        <% } %>
    </ul>

    <a href="/users/<%= user._id %>/foods/new">Add a food</a>

  </body>
</html>
